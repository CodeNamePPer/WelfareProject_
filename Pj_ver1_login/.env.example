# ---- Session ----
# สร้างด้วย: openssl rand -base64 48  (ต้องยาวอย่างน้อย 32 ตัวอักษร)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Google reCAPTCHA v3 (ไม่มีกล่องติ๊ก ให้คะแนนอัตโนมัติ) ----
# สร้างที่ https://www.google.com/recaptcha/admin (ประเภท: คะแนน / v3) และเพิ่มโดเมน เช่น localhost
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# คะแนนขั้นต่ำ 0.0–1.0 (ค่าเริ่มต้น 0.5)
RECAPTCHA_MIN_SCORE=0.5

# ---- จำกัดให้เข้าได้เฉพาะเครือข่ายที่ทำงาน ----
ENFORCE_OFFICE_NETWORK=false
# IP หรือ CIDR (IPv4) คั่นด้วยจุลภาค เช่น 203.0.113.10,10.0.0.0/8,192.168.1.0/24
OFFICE_ALLOWED_IPS=
DATA_DIR=

# ---- อีเมล: รหัสผ่านชั่วคราว และอีเมลแจ้งเตือนถึงผู้ขอ / HR / การเงิน ----
# ไม่ตั้ง Gmail และ Resend = ไม่ส่งอีเมล ระบบแสดงรหัสบนจอให้ admin แทน
#
# แบบที่ 1 Gmail (แนะนำเมื่อยังไม่มีโดเมน) ส่งถึงอีเมลจริงของแต่ละคนได้ทุกโดเมน ราว 500 ฉบับต่อวัน
#   1) เปิดการยืนยันตัวตน 2 ขั้นตอนของบัญชี Gmail ที่จะใช้ส่ง
#   2) สร้าง "รหัสผ่านสำหรับแอป" ที่ https://myaccount.google.com/apppasswords
#   ตั้งแล้วระบบใช้ Gmail ก่อน Resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# แบบที่ 2 Resend
RESEND_API_KEY=
# Resend: ต้องเป็นโดเมนที่ verify แล้ว ยังไม่มีโดเมนใช้ onboarding@resend.dev (ส่งได้แค่อีเมลเจ้าของบัญชี Resend)
# Gmail: ใช้แค่ชื่อที่แสดง ที่อยู่ผู้ส่งเป็น GMAIL_USER เสมอ
EMAIL_FROM=ระบบพนักงานและสวัสดิการ <onboarding@resend.dev>
# ช่วงทดสอบ: ส่งทุกฉบับไปที่อีเมลนี้แทนผู้รับจริง (เว้นว่างเมื่อใช้งานจริง)
EMAIL_TEST_TO=
# ช่วงทดสอบ: ส่งอีเมลแจ้งเตือนเฉพาะของคนเหล่านี้ คนอื่นข้าม (เว้นว่างเมื่อใช้งานจริง)
# hr_head = หัวหน้า HR คนปัจจุบัน หรือใส่รหัสพนักงานคั่นด้วยจุลภาค เช่น hr_head,E00002
EMAIL_ONLY_TO=

# ---- ลิงก์ในอีเมลแจ้งเตือน ----
# URL ของระบบที่ผู้ใช้เปิด เช่น https://welfare.example.com (ไม่ตั้ง = อีเมลไม่มีลิงก์)
APP_URL=
