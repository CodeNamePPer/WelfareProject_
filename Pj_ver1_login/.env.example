# ---- Supabase ----
# Project Settings > API ของโปรเจกต์ Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ใช้ฝั่ง server เท่านั้น ห้ามใส่ใน NEXT_PUBLIC_* และห้าม commit ค่าจริง
SUPABASE_SERVICE_ROLE_KEY=

# ---- Session ----
# สร้างด้วย: openssl rand -base64 48  (ต้องยาวอย่างน้อย 32 ตัวอักษร)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Google reCAPTCHA v3 (ไม่มีกล่องติ๊ก ให้คะแนนอัตโนมัติ) ----
# สร้างที่ https://www.google.com/recaptcha/admin (ประเภท: คะแนน / v3) และเพิ่มโดเมน เช่น localhost
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ---- อีเมลแจ้งเตือน ----
# ช่องทางที่ 1 (ใช้ก่อน): Gmail SMTP ส่งถึงอีเมลจริงของผู้รับได้ทุกโดเมน (~500 ฉบับ/วัน)
# GMAIL_USER = บัญชี Gmail ที่ใช้ส่ง (ผู้รับเห็นเป็นผู้ส่ง)
# GMAIL_APP_PASSWORD = รหัสผ่านสำหรับแอป 16 ตัว จาก https://myaccount.google.com/apppasswords
#   (ต้องเปิดการยืนยันตัวตน 2 ขั้นตอนก่อน · ไม่ใช่รหัสผ่าน Gmail ปกติ · ห้าม commit ค่าจริง)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# ช่องทางที่ 2: Resend ใช้เมื่อไม่ได้ตั้ง Gmail (onboarding@resend.dev ส่งได้แค่อีเมลเจ้าของบัญชี Resend)
RESEND_API_KEY=
# ผู้ส่ง "ชื่อ <ที่อยู่>" · Gmail ใช้แค่ชื่อที่แสดง ที่อยู่ผู้ส่งเป็น GMAIL_USER เสมอ · Resend ต้องเป็นโดเมนที่ verify แล้ว
EMAIL_FROM=
# ช่วงทดสอบ: ส่งทุกฉบับไปที่อีเมลนี้แทนผู้รับจริง · เว้นว่าง = ส่งถึงอีเมลของแต่ละคนจริง
EMAIL_TEST_TO=
# ช่วงทดสอบ: ส่งแจ้งเตือนเฉพาะรหัสพนักงานเหล่านี้ เช่น hr_head หรือ E00010,E00002 · เว้นว่าง = ส่งทุกคน
EMAIL_ONLY_TO=
# ลิงก์ "เปิดดูในระบบ" ในอีเมลแจ้งเตือน เช่น http://localhost:3000
APP_URL=
