# ---- Session ----
# สร้างด้วย: openssl rand -base64 48  (ต้องยาวอย่างน้อย 32 ตัวอักษร)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Google reCAPTCHA v2 (checkbox) ----
# สร้างที่ https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- จำกัดให้เข้าได้เฉพาะเครือข่ายที่ทำงาน ----
ENFORCE_OFFICE_NETWORK=false
# IP หรือ CIDR (IPv4) คั่นด้วยจุลภาค เช่น 203.0.113.10,10.0.0.0/8,192.168.1.0/24
OFFICE_ALLOWED_IPS=
DATA_DIR=

# ---- อีเมล (Resend) ส่งรหัสผ่านชั่วคราวตอน admin รีเซ็ต ----
# ไม่ตั้ง RESEND_API_KEY = ไม่ส่งอีเมล ระบบแสดงรหัสบนจอให้ admin แทน
RESEND_API_KEY=
# ต้องเป็นโดเมนที่ verify ใน Resend แล้ว ยังไม่มีโดเมนใช้ onboarding@resend.dev (ส่งได้แค่อีเมลเจ้าของบัญชี Resend)
EMAIL_FROM=ระบบพนักงานและสวัสดิการ <onboarding@resend.dev>
# ช่วงทดสอบ: ส่งทุกฉบับไปที่อีเมลนี้แทนผู้รับจริง (เว้นว่างเมื่อใช้งานจริง)
EMAIL_TEST_TO=
